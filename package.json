{
  "name": "rnsk-toolkits-monorepo",
  "private": true,
  "workspaces": [
    "packages/toolkits",
    "sandbox"
  ],
  "scripts": {
    "build": "npm run build -w @rnsk/toolkits",
    "validate": "npm run validate -w @rnsk/toolkits",
    "sandbox": "npm run dev -w sandbox",
    "sandbox:npm": "npm run dev:npm -w sandbox",
    "sandbox:test": "npm test -w sandbox",
    "format": "prettier --write \"packages/**/*.ts\" \"sandbox/**/*.{ts,tsx,js,mjs}\" \"skills/**/*.md\"",
    "format:check": "prettier --check \"packages/**/*.ts\" \"sandbox/**/*.{ts,tsx,js,mjs}\" \"skills/**/*.md\""
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  }
}
