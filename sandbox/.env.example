# Copy to sandbox/.env.local — everything here is optional.
# Without any keys the sandbox still starts and the Tool runner works.

# ── Chat LLM (free models only) ──────────────────────────────────────────────
# Set ONE key. The sandbox uses whichever it finds.
# Gemini:     https://aistudio.google.com/apikey   (GOOGLE_GENERATIVE_AI_API_KEY also works)
# OpenRouter: https://openrouter.ai/keys
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Only needed if both keys are set (default: gemini).
# SANDBOX_LLM_PROVIDER=gemini

# Override the model. Must be free:
#   gemini     → gemini-2.5-flash | gemini-2.5-flash-lite | gemini-flash-latest | gemini-flash-lite-latest
#   openrouter → any id ending in ":free" that supports tool calling
# Leave empty to use the default (OpenRouter auto-picks a free model with tool support).
# SANDBOX_MODEL=

# ── Toolkit credentials ─────────────────────────────────────────────────────
# Service env toolkits (e.g. Firecrawl):
# FIRECRAWL_API_KEY=

# OAuth toolkits: set the token by its field name, e.g. a GitHub personal access token.
# You can also paste tokens in the UI instead (kept in memory only).
# githubToken=

# ── Server ───────────────────────────────────────────────────────────────────
# Which @rnsk/toolkits to run: local (packages/toolkits/src, default) or npm (published 0.0.5).
# Prefer `npm run sandbox:npm` over setting this.
# TOOLKITS_SOURCE=local
# PORT=3100
# HOST=127.0.0.1
