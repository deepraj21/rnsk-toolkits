{
  "name": "sandbox",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:npm": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server:npm\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false --include .env.local --include .env server/index.ts",
    "dev:server:npm": "tsx watch --clear-screen=false --include .env.local --include .env server/index.ts --toolkits=npm",
    "dev:web": "node scripts/wait-for-server.mjs && vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test server/contract.test.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.121",
    "@ai-sdk/react": "^3.0.285",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@rnsk/bot": "^0.0.4",
    "@rnsk/toolkits-published": "npm:@rnsk/toolkits@0.0.5",
    "ai": "^6.0.282",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "vite": "^8.3.0"
  }
}
