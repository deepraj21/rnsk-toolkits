{
  "name": "@rnsk/toolkits",
  "version": "0.0.12",
  "description": "Runstack toolkit registry — manifest-driven tool definitions for AI agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "README.md",
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "validate": "tsx scripts/validate.ts && tsx scripts/validate-esm.ts --source",
    "validate:dist": "tsx scripts/validate-esm.ts --dist",
    "build": "tsc && npm run validate:dist",
    "prepublishOnly": "npm run validate && npm run build"
  },
  "peerDependencies": {
    "ai": "^6.0.0",
    "zod": "^3.23.0 || ^4.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-api-gateway": "^3.1139.0",
    "@aws-sdk/client-auto-scaling": "^3.1139.0",
    "@aws-sdk/client-billing": "^3.1139.0",
    "@aws-sdk/client-budgets": "^3.1139.0",
    "@aws-sdk/client-cloudformation": "^3.1139.0",
    "@aws-sdk/client-cloudfront": "^3.1139.0",
    "@aws-sdk/client-cloudtrail": "^3.1139.0",
    "@aws-sdk/client-cloudwatch": "^3.1134.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1134.0",
    "@aws-sdk/client-codeartifact": "^3.1139.0",
    "@aws-sdk/client-codebuild": "^3.1139.0",
    "@aws-sdk/client-codedeploy": "^3.1139.0",
    "@aws-sdk/client-codepipeline": "^3.1139.0",
    "@aws-sdk/client-cost-and-usage-report-service": "^3.1139.0",
    "@aws-sdk/client-cost-explorer": "^3.1139.0",
    "@aws-sdk/client-dynamodb": "^3.1139.0",
    "@aws-sdk/client-ebs": "^3.1139.0",
    "@aws-sdk/client-ec2": "^3.1134.0",
    "@aws-sdk/client-ecr": "^3.1139.0",
    "@aws-sdk/client-ecs": "^3.1139.0",
    "@aws-sdk/client-eks": "^3.1139.0",
    "@aws-sdk/client-elasticache": "^3.1139.0",
    "@aws-sdk/client-eventbridge": "^3.1139.0",
    "@aws-sdk/client-guardduty": "^3.1139.0",
    "@aws-sdk/client-iam": "^3.1139.0",
    "@aws-sdk/client-kms": "^3.1139.0",
    "@aws-sdk/client-lambda": "^3.1139.0",
    "@aws-sdk/client-rds": "^3.1139.0",
    "@aws-sdk/client-route-53": "^3.1139.0",
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/client-securityhub": "^3.1139.0",
    "@aws-sdk/client-shield": "^3.1139.0",
    "@aws-sdk/client-sns": "^3.1139.0",
    "@aws-sdk/client-sqs": "^3.1139.0",
    "@aws-sdk/client-vpc-lattice": "^3.1139.0",
    "@aws-sdk/client-wafv2": "^3.1139.0",
    "@aws-sdk/client-xray": "^3.1139.0",
    "@aws-sdk/lib-dynamodb": "^3.1139.0",
    "@google-cloud/compute": "^7.4.0",
    "@google-cloud/monitoring": "^6.1.0",
    "firecrawl": "^4.38.0",
    "octokit": "^5.0.5",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "ai": "^6.0.62",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "zod": "^3.24.2"
  },
  "author": "Deepraj Bera",
  "repository": {
    "type": "git",
    "url": "https://github.com/deepraj21/rnsk-toolkits"
  },
  "license": "MIT",
  "homepage": "https://runstack.engineer",
  "keywords": [
    "runstack",
    "ai-sdk",
    "vercel-ai-sdk",
    "mcp",
    "tools",
    "agents",
    "llm"
  ]
}
